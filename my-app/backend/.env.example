# =============================================
# .env.example — このファイルをコピーして .env を作成してください
# cp .env.example .env
# =============================================

# JWT署名に使う秘密鍵（本番では必ず長いランダム文字列を設定すること）
# 生成例: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# MySQLデータベース接続URL
DATABASE_URL=mysql+pymysql://appuser:apppass@db:3306/appdb

# 管理者初期アカウント（初回起動時に自動作成）
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# JWTトークンの有効期限（分）
ACCESS_TOKEN_EXPIRE_MINUTES=1440
